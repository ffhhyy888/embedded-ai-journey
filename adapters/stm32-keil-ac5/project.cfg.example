# ============================================================================
# project.cfg —— 工程级配置（参考模板）
# ============================================================================
#
# ⚠️ 这是一份【参考模板】，不是任何工程的运行配置。
#    取值全部来自真实工程 SDIO_test（STM32F407VET6 + Keil MDK/ARMCC AC5），
#    逐项核对过 tools/build.py、tools/serial_tool.py、tools/hil.py、
#    tests/test_static.py 的实际常量与 tools/build_logs/ 的真实构建日志。
#
# 复制到新工程时，下列各项【必须重新校准】，不要照抄：
#   1. [project] name               —— 工程名（= Keil 工程名 = 产物目录名）
#   2. [build]   uvprojx / axf      —— 新工程的工程文件与产物路径
#   3. [build]   min_compile_lines  —— 必须按新工程【实测】的全量编译动作数重定
#   4. [serial]  port / baud        —— 换板子或换 USB 口后端口号会变
#   5. [serial]  boot_marker        —— 新工程的启动契约多半与 SDIO_test 不同
#   6. [image]   flash_size / ram_size / required_symbols —— 按新芯片与新工程填
#
# 用法：
#   cp <平台仓库>/adapters/stm32-keil-ac5/project.cfg.example <新工程>/tools/project.cfg
#   然后逐项按新工程填写，并把上面这段"参考模板"说明改写成新工程自己的说明。
#
# 解析器：skeleton/tools/project_config.py（Python 标准库 configparser，无第三方依赖）
#   · 注释：整行可用 `#` 或 `;`；**行尾注释只能用 `;`，且前面必须有空格**
#   · 值里的 `%` 原样保留（插值已关闭），不会被当成占位符
#   · 路径一律用正斜杠 `/`；相对路径相对【工程根】（即 tools/ 的上一级）
#   · 键名大小写不敏感；值的前后空白会被去掉
#   · 【缺失即报错】本文件缺失、或某个必需项缺失时，工具会直接报错并给修复提示，
#     不会静默回落到内置默认值 —— 避免"改了配置却不生效"这种最难查的问题
# ============================================================================


[project]

# 工程名。换工程必须改。
# 依据：MDK-ARM/SDIO_test.uvprojx 里的 <TargetName>/<OutputName>，也是 Keil 输出目录名
name = SDIO_test


[build]

# Keil 工程文件（相对工程根）。换工程必须改。
uvprojx = MDK-ARM/SDIO_test.uvprojx

# 构建产物 .axf（相对工程根）。
# ⚠️ **按 Keil 的 Output Directory 设置填，别想当然** —— 实测发现
#    `<OutputName>`（决定文件名）与 `<OutputDirectory>`（决定目录）是**两个独立设置**，
#    目录**不跟工程名走**。SDIO_test 恰好两者同名，容易让人以为有对应关系。
#    填错的表现很迷惑：**构建明明成功，判据 4 却报"产物不存在"**。
# 四判据之四（"产物时间戳已更新"）读的就是这个文件。
axf = MDK-ARM/SDIO_test/SDIO_test.axf

# 四判据之三的阈值：构建日志里 compiling/assembling/linking 的行数下界。
# 作用：防"增量构建什么都没编却返回 0"这种假 0。
# ⚠️ 必须按新工程【实测】标定：跑一次全量构建，数一下实际条数，
#    取一个"真构建必然超过、空转必然达不到"的安全下界。
# 本例出处：SDIO_test 全量构建实测 56 条（见 tools/build_logs/ 的 PASS 日志），
#          取约 1/3 作为下界 20。
min_compile_lines = 20


[flash]

# 烧录日志落盘位置（相对工程根）；失败取证时会连同其它证据一起收集。
log = MDK-ARM/flash.log


[serial]

# 串口端口。换板子或换 USB 口后会变（在设备管理器里查）。
# 优先级：--port 参数 > 环境变量 AUTOLAB_PORT > 本项 > 内置默认
port = COM9

# 波特率。必须与固件侧一致，否则 PC 收到的永远是同一个垃圾字节。
baud = 115200

# 复位后固件应依次发出的"启动标记"。
# SDIO_test 的契约：U=时钟/UART 就绪，S=SDIO 初始化通过，h=进入主循环。
# ⚠️ 新工程的启动标记通常【不同】—— 例如没有 SDIO 的工程就不该有 S。
boot_marker = USh

# 软复位命令（十六进制字节）。固件侧约定：收到该字节即 NVIC_SystemReset()。
# 1b = ESC。有了它，冒烟测试无需人工按复位键，可被 pytest / CI 直接调用。
reset_cmd_hex = 1b


[ioc]

# CubeMX 配置源文件名（相对工程根）；代码由它生成。
file = SDIO_test.ioc

# 是否启用 ".ioc ↔ 代码" 一致性检查。
# 非 CubeMX 工程（手写工程或其它生成器）设 false —— 相关用例会【显式 SKIP】，
# 而不是静默通过。
enabled = true                  ; 非 CubeMX 工程改 false


[image]

# ---- 内存预算（字节），供镜像契约测试使用 ----
# 校验规则：Code + RO-data + RW-data <= flash_size ； RW-data + ZI-data <= ram_size
# ⚠️ 写大了等于没有检查；必须来自数据手册或 Keil 的 Device 设置。
# 本例：STM32F407VET6 = 512 KiB Flash @0x08000000 / 128 KiB RAM @0x20000000
#      （Keil 里 IROM=0x80000；IRAM=0x1C000 + IRAM2=0x4000，合计 0x20000）
# 本例当前实际占用：Code=10456 RO-data=456 RW-data=36 ZI-data=1772
#      -> Flash 10948 / 524288 ； RAM 1808 / 131072（余量充足）
flash_size = 524288

ram_size = 131072               ; 32 KiB 以内的小芯片别忘了改小

# 必须出现在最终镜像里的符号（逗号分隔），每个都会被逐一断言。
# ⚠️ 换成新工程【真正关键】的符号。
#    MX_SDIO_SD_Init 是 SDIO_test 的【业务专属】符号，新工程多半没有它；
#    main / SystemClock_Config / UART 回调 是更通用的起点。
required_symbols = main, SystemClock_Config, MX_SDIO_SD_Init, HAL_UART_RxCpltCallback, HAL_UART_ErrorCallback
